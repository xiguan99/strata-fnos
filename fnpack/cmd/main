#!/bin/bash
# strata-fnos 生命周期入口（单进程原生直跑，无壳）
# 自带 node runtime 直接跑官方 server，原生绑 0.0.0.0:8791（对外端口不变）；桌面图标端口直达，不走统一网关
# 零宿主机依赖：node/engine 均为官方 AppImage 解包自带
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}"

LIB_TYPE="${wizard_data_library_type:-data}"
if [ "${LIB_TYPE}" = "data" ]; then
    DATA_LIBRARY_PATH="${TRIM_PKGVAR}"
else
    DATA_LIBRARY_PATH="${TRIM_DATA_SHARE_PATHS%%:*}"
fi
RUN_USER="${wizard_run_user:-root}"
DATA_DIR="${DATA_LIBRARY_PATH}/data"

# 官方自带 node runtime（AppImage 解包件）
NODE="${APP_DIR}/node/node"

export HOME="${DATA_DIR}"
# 模型/视觉依赖下载走国内可达镜像（本机直连 huggingface.co 不通，实测 hf-mirror 可达；
# 也可临时改 STRATA_SOURCE=modelscope 走 ModelScope，但那边是仓库当前文件、丢了 pinned 版本校验）
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"

export STRATA_PORT="8791"           # 对外端口（原生绑定，桌面图标端口直达）
export STRATA_BIND="0.0.0.0"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> "${LOG_FILE}"; }
log_err() { echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" >> "${LOG_FILE}"; }
check_process() { ps -p "$1" >/dev/null 2>&1; }

as_run_user() {
    if [ "${RUN_USER}" != "root" ] && id "${RUN_USER}" >/dev/null 2>&1; then
        su -s /bin/bash "${RUN_USER}" -c "$1"
    else
        bash -c "$1"
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then return 0; else rm -f "${PID_FILE}"; fi
    fi
    return 1
}

# 装机首个模型前，官方的 setup 会在数据根下建 packs/ 与 mtp/（iq_pack.py、mtp_fetch.py 直接写）。
# 数据根常是用户在设置里选的共享目录（例如 /vol1/1000，属主可能是别的账号），应用用户建不了就在
# Python 里抛 PermissionError。这里以 root 先把同级目录建好并把属主交给应用用户，app 侧只做可写预检。
prepare_data_dirs() {
    settings="${DATA_DIR}/.local/share/strata/app-settings.json"
    roots="${DATA_DIR}"
    if [ -f "${settings}" ]; then
        chosen=$(sed -n 's/.*"data_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${settings}" | head -n 1)
        [ -n "${chosen}" ] && [ "${chosen}" != "${DATA_DIR}" ] && roots="${roots} ${chosen}"
    fi
    for root in ${roots}; do
        [ -d "${root}" ] || continue
        for item in models packs mtp; do
            target="${root}/${item}"
            if [ ! -d "${target}" ]; then
                mkdir -p "${target}" 2>/dev/null || { log_err "数据根 ${root} 下建不了 ${item}/（可写性不足），安装首个模型前请在 Strata 设置里换模型文件夹"; continue; }
            fi
            owner=$(stat -c '%U' "${target}" 2>/dev/null)
            if [ "${RUN_USER}" != "root" ] && id "${RUN_USER}" >/dev/null 2>&1; then
                if [ "${owner}" != "${RUN_USER}" ]; then
                    chown -R "${RUN_USER}:$(id -gn "${RUN_USER}" 2>/dev/null)" "${target}" 2>/dev/null || log_err "改不了 ${target} 的属主（需要 root）"
                fi
                chmod u+rwx,g+rwx "${target}" 2>/dev/null
            fi
            writable=1
            if [ "${RUN_USER}" != "root" ] && id "${RUN_USER}" >/dev/null 2>&1; then
                as_run_user "test -w '${target}'" || writable=0
            else
                [ -w "${target}" ] || writable=0
            fi
            [ "${writable}" = "1" ] || log_err "数据目录 ${target} 对应用用户 ${RUN_USER} 不可写：飞牛只允许应用写「应用设置 → 访问权限 → 允许访问以下文件夹」里授权的目录，请把该目录加进去并选「读写」（或在这儿换一个模型文件夹）"
        done
    done
}

start_backend() {
    status && return 0
    prepare_data_dirs
    [ -x "${NODE}" ] || { log_err "找不到 ${NODE}"; return 1; }
    [ -d "${APP_DIR}/host/dist" ] || { log_err "找不到 ${APP_DIR}/host/dist"; return 1; }
    log_msg "启动 strata host (端口=${STRATA_PORT}, 绑定=${STRATA_BIND}, USER=${RUN_USER}, DATA=${DATA_DIR})"
    # HOME 必须在 as_run_user 的 shell 里再 export 一次：su -c 会把 HOME 重置成应用用户的家目录（装机环境里
    # 那个目录往往不存在），host 的 store.mjs 会因找不到可写数据目录直接退出。
    as_run_user "cd '${APP_DIR}/host' && export HOME='${DATA_DIR}' && exec '${NODE}' server/index.mjs --dist dist >> '${LOG_FILE}' 2>&1 & echo \$!" &
    pid=$!
    sleep 3
    if ! check_process "${pid}"; then
        real=$(pgrep -f "${NODE} server/index.mjs --dist dist" | head -1)
        [ -n "${real}" ] && pid="${real}"
    fi
    if check_process "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}"
        log_msg "strata host 启动成功 PID=${pid}"
    else
        log_err "strata host 启动失败"
        return 1
    fi
}

stop_pidfile() {
    pf="$1"; pat="$2"
    if [ -f "${pf}" ]; then
        pid=$(head -n 1 "${pf}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null
            count=0
            while check_process "${pid}" && [ $count -lt 5 ]; do sleep 1; count=$((count+1)); done
            check_process "${pid}" && { log_err "5 秒未退出，SIGKILL"; kill -KILL "${pid}" 2>/dev/null || true; }
        fi
        rm -f "${pf}"
    fi
    pkill -9 -f "${pat}" 2>/dev/null || true
}

stop_backend() {
    log_msg "停止 strata host"
    stop_pidfile "${PID_FILE}" "${NODE} server/index.mjs --dist dist"
    log_msg "已停止"
    return 0
}

start_process() {
    start_backend || return 1
    return 0
}

stop_process() {
    stop_backend
    log_msg "已停止"
    return 0
}

case $1 in
start)            start_process ;;
stop)             stop_process ;;
status)           status && exit 0 || exit 3 ;;
start-backend)    start_backend ;;
stop-backend)     stop_backend ;;
restart-backend)  stop_backend; start_backend ;;
*)                exit 1 ;;
esac
