#!/bin/bash
# 安装后回调：建数据目录 → 首启 → 就绪确认（无外部依赖，即刻可起）
LOG_FILE="${TRIM_PKGVAR}/info.log"
touch "${LOG_FILE}" 2>/dev/null || true
log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> "${LOG_FILE}" 2>/dev/null || true; }

LIB_TYPE="${wizard_data_library_type:-data}"
if [ "${LIB_TYPE}" = "data" ]; then
    DATA_LIBRARY_PATH="${TRIM_PKGVAR}"
else
    DATA_LIBRARY_PATH="${TRIM_DATA_SHARE_PATHS%%:*}"
fi
RUN_USER="${wizard_run_user:-root}"
DATA_DIR="${DATA_LIBRARY_PATH}/data"

log_msg "install_callback: DATA=${DATA_LIBRARY_PATH}, USER=${RUN_USER}"
[ -n "${DATA_LIBRARY_PATH}" ] && mkdir -p "${DATA_DIR}"

if [ "${RUN_USER}" != "root" ] && id "${RUN_USER}" >/dev/null 2>&1; then
    chown -R "${RUN_USER}" "${DATA_DIR}" 2>/dev/null || true
    chown -R "${RUN_USER}" "${TRIM_PKGVAR}" 2>/dev/null || true
fi

# 首启失败绝不能带崩安装流程：install_callback 返回非 0 会被 fnOS 判成
# ErrCodeInstallCallbackException(10238)，UI 只显示「执行脚本出错且原因未知」并整包回滚。
# 最常见原因是 service_port 被别的程序占用（例如 8791 已交给面板），此时安装照常完成。
START_PORT="${TRIM_SERVICE_PORT:-8791}"
bash "$(dirname "$0")/main" start
START_RC=$?
if [ "${START_RC}" -eq 0 ]; then
    log_msg "install_callback 完成（strata host 已启动，端口 ${START_PORT}）"
else
    HOLDER="$(ss -lntp 2>/dev/null | grep -F ":${START_PORT} " | head -n 3 | tr '\n' ' ' | sed 's/  */ /g')"
    log_msg "首启未成功 rc=${START_RC}：安装继续、不影响本次升级；端口 ${START_PORT} 当前占用者=${HOLDER:-未探测到}。需要时可在应用中心点启动，或先停掉占用该端口的程序"
fi
exit 0
